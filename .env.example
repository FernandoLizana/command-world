# DR Command — local installation
SECRET_KEY=change-me-in-production

# SQLite by default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dr_command
DATABASE_URL=sqlite:///instance/empire.db

# Optional sample world. Essential features work with an empty world.
DEMO_MODE=false

# Local owner of this installation. Change these before real use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=commander@localhost

# Ollama — optional. The app works without it.
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=8

# Sonido preparado; no se reproduce solo.
SOUND_ENABLED=false

FLASK_APP=app.py
FLASK_DEBUG=false
